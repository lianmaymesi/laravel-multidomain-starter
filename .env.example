APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.yourapp.test

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_MAIN_DOMAIN=yourapp.test
# Set to true to run every portal (auth/account/app/backoffice) on APP_MAIN_DOMAIN
# instead of its own subdomain. See docs: single-vs-multi-domain.
APP_SINGLE_DOMAIN=false

# Absolute kill switch — true takes down every portal, backoffice included,
# with the custom maintenance page. See docs: maintenance-mode. For
# per-portal maintenance instead, use the toggle in Backoffice > Maintenance.
APP_MAINTENANCE=false

# Feature modules — set to false to switch a module off entirely (no routes,
# nav entry, or middleware; data is kept). See config/modules.php.
# MODULE_MAINTENANCE=true
# MODULE_CURRENCY=true
# MODULE_LANGUAGE=true
# MODULE_ACTIVITY=true
# MODULE_MEDIA=true
# MODULE_API=false
# MODULE_BILLING=false

# Media module: any filesystems.php disk (local = private, served via signed URLs).
# For S3 / Cloudflare R2 / DigitalOcean Spaces: composer require league/flysystem-aws-s3-v3,
# fill AWS_* (+ AWS_ENDPOINT, AWS_USE_PATH_STYLE_ENDPOINT=true for R2/Spaces), MEDIA_DISK=s3.
# MEDIA_DISK=local
# MEDIA_IMAGE_DRIVER=gd

# API (api.<APP_MAIN_DOMAIN>/v1): requests per minute per token user.
# API_RATE_LIMIT=60

# /health: token that unlocks per-check detail (monitors), and who gets
# emailed when the overall status changes (comma-separated).
HEALTH_TOKEN=
HEALTH_NOTIFY_MAIL=

# Backups (config/backup.php): daily DB dump + storage/app zip. BACKUP_DISKS is
# comma-separated filesystem disks — add an off-server one in production
# (e.g. backups,s3). Failures/stale backups email BACKUP_NOTIFY_MAIL
# (falls back to HEALTH_NOTIFY_MAIL). Keep the archive password off-server.
BACKUP_ENABLED=false
BACKUP_DISKS=backups
BACKUP_NOTIFY_MAIL=
BACKUP_ARCHIVE_PASSWORD=

# Search (config/scout.php): "database" searches the tables directly — no extra
# service. Switch to meilisearch for large tables (see README "Search").
SCOUT_DRIVER=database

# Billing module (MODULE_BILLING=true) — Stripe via Laravel Cashier. Keys from
# the Stripe dashboard; the webhook secret from the endpoint pointing at
# https://<any-portal-host>/stripe/webhook (see README "Billing"). Each plan in
# app/Modules/Billing/config.php needs a Stripe Price id to be offered.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd
BILLING_STARTER_PRICE=
BILLING_PRO_PRICE=
BILLING_TRIAL_DAYS=0

# Demo auth feature only — phone OTP via Twilio, not required by the starter kit core.
# Disabled by default: registration/account settings hide the phone field entirely
# and every phone-verification gate (middleware, guest redirects) is skipped.
PHONE_VERIFICATION_ENABLED=false
# 'single' — one fixed country code (below), field hidden from users.
# 'multi' — users type their own country code (plain text, not fully supported yet).
PHONE_COUNTRY_MODE=single
PHONE_DEFAULT_COUNTRY_CODE=+91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Seeded staff/backoffice account (php artisan db:seed), assigned the "Super Admin" role.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
# Leave empty to have `php artisan app:setup` generate one and print it once.
ADMIN_PASSWORD=
# Shared password for `app:setup --demo` accounts (empty = generated).
DEMO_PASSWORD=

# Comma-separated feature flag names forced off everywhere (kill switch)
# PENNANT_KILLED=

